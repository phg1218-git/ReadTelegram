# ── 필수 설정 ──────────────────────────────────────────────────────────────
# https://my.telegram.org 에서 발급
TELEGRAM_API_ID=여기에_api_id
TELEGRAM_API_HASH=여기에_api_hash

# ── 채널 목록 ──────────────────────────────────────────────────────────────
# 자주 수집할 텔레그램 채널/그룹 주소 목록 (쉼표로 구분)
# 아래 형식 모두 사용 가능:
#   https://t.me/channel_a, t.me/channel_b, @channel_c, channel_d
TELEGRAM_CHANNELS=https://t.me/channel_a,https://t.me/channel_b,@channel_c,channel_d

# ── 수집 설정 ──────────────────────────────────────────────────────────────
# 최근 몇 시간 이내 메시지를 수집할지 설정 (기본값: 12)
# 처음 세팅할 때는 12 권장, 안정화 후 3으로 줄여도 됨
TELEGRAM_LOOKBACK_HOURS=12

# ── 파일 다운로드 설정 ────────────────────────────────────────────────────
# 다운로드할 파일 유형 (기본값: all)
#   all           - 모든 첨부파일 다운로드
#   document_only - PDF/엑셀/파워포인트/워드/텍스트 등 문서만
#   media_only    - 이미지/영상만
DOWNLOAD_FILE_TYPES=all

# 파일 자동 다운로드 최대 용량 (MB 단위, 기본값: 0 = 제한 없음)
MAX_FILE_SIZE_MB=0

# 허용할 파일 확장자 allowlist (쉼표로 구분, 기본값: 비워두면 전체 허용)
# 설정 시 여기 포함된 확장자만 다운로드 — DOWNLOAD_FILE_TYPES 보다 우선 적용
# 예시: .pdf,.ppt,.pptx  →  PDF와 파워포인트만 다운로드
# 점(.)은 있어도 없어도 됨
INCLUDE_FILE_EXTS=

# 제외할 파일 확장자 blocklist (쉼표로 구분, 기본값: 비워두면 제외 없음)
# 예시: .mp4,.avi,.mov  →  동영상 파일 제외
EXCLUDE_FILE_EXTS=

# ── 정리 설정 ──────────────────────────────────────────────────────────────
# 다운로드 파일 보관 기간 (일 단위, cleanup_files.py 에서 사용, 기본값: 30)
KEEP_ORIGINAL_FILE_DAYS=30

# ── 실행 환경 설정 ────────────────────────────────────────────────────────
# exe 실행 후 콘솔 창을 자동으로 닫을지 여부 (기본값: true = 열어둠)
KEEP_CONSOLE_OPEN=true
